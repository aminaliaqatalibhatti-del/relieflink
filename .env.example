# ReliefLink — Vercel + Supabase environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env to GitHub.

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Admin dashboard sign-in credentials
ADMIN_EMAIL=admin@relieflink.pk
ADMIN_PASSWORD=choose-a-strong-password

# AI Copilot — Gemini key from https://aistudio.google.com/apikey
# Without this the copilot falls back to the offline keyword engine.
GEMINI_API_KEY=your_gemini_api_key
# Optional: pin one model instead of trying the default aliases in order
# GEMINI_MODEL=gemini-flash-latest

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://yourusername.github.io
